# Copy to .env in the repo root (gitignored) and fill in what you have. Everything is optional;
# smoke tests SKIP whatever isn't configured.

# --- Service locations (defaults = everything on your own machine).
# To use a shared team machine instead, point these at it (e.g. http://<host>:11434).
# KEV_ENABLED=false                      # rules only (default); true = Kev-assisted, see S-052
# KEV_BASE_URL=http://127.0.0.1:8009     # Kev decision model on the GPU machine (S-032)
# KEV_MODE=off                           # off | assisted | led (led: branch noah, DECISIONS.md D-08)
# KEV_PROVIDER=kev                       # kev (local) | jev (hosted TypeSafe; led defaults to jev)
# TYPESAFE_API_KEY=                      # only for KEV_PROVIDER=jev
# KEV_LEAD_CLEAR=0.70                    # led: model "harmless" at least this sure turns a keyword rejection into a review
# KEV_LEAD_REJECT=0.50                   # led: model "prohibited" at least this sure rejects what the keywords missed
# ASSIST_ENABLED=false                   # writing help on the applicant form (S-087); make dev turns it on
# ASSIST_PROVIDER=anthropic              # anthropic (default, needs ANTHROPIC_API_KEY) | ollama (self-hosted Qwen)
# ASSIST_MODEL=claude-opus-5-5           # default per provider; ollama: qwen3.8:27b
# ASSIST_URL=http://127.0.0.1:11435      # ollama only: SSH tunnel, docs/SETUP-assist.md
# FHIR_BASE=http://localhost:8080/fhir
# OLLAMA_URL=http://localhost:11434
# OLLAMA_GENERAL_MODEL=gemma4:12b
# TRACK3_DATA=data/track3             # challenge data location
# ICD10_XML=data/icd10/icd102019en.xml # WHO ICD-10 (ClaML) for the definition check
